{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Amount",
  "description": "An amount of money in a currency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "currency"
  ],
  "properties": {
    "value": {
      "type": "number",
      "description": "The amount, in units of the currency, e.g. 1250.50."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Currency (ISO 4217)."
    }
  }
}
