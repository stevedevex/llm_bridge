<?xml version="1.0" encoding="UTF-8"?>
<!-- Customer Directory Service 1.3.0: request, response and fault messages. -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:dt="urn:example:directory:types:v1"
            targetNamespace="urn:example:directory:messages:v1"
            elementFormDefault="qualified"
            version="1.3.0">

  <xsd:import namespace="urn:example:directory:types:v1" schemaLocation="directory-types.xsd"/>

  <xsd:element name="GetPartyRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="PartyId" type="xsd:string">
          <xsd:annotation><xsd:documentation>The customer's identifier.</xsd:documentation></xsd:annotation>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="GetPartyResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="Party" type="dt:Party"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="GetBalanceRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="AccountNumber" type="xsd:string">
          <xsd:annotation><xsd:documentation>The account whose balances to give.</xsd:documentation></xsd:annotation>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="GetBalanceResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="Balance" type="dt:Balance" minOccurs="0" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="DirectoryFault">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="FaultCode" type="xsd:string">
          <xsd:annotation>
            <xsd:documentation>PARTY_NOT_FOUND, ACCOUNT_NOT_FOUND or UNAVAILABLE.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="FaultText" type="xsd:string" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
