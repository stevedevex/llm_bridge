#!/bin/sh
# The bridge-kit MCP server, over stdio: the IDE starts this once per session, from each person's own MCP settings
# (README, "The MCP server"). Like bin/bridge-kit, it runs through bridge-kit-run, in the BA repo's .work/venvs/bridge-kit, and
# without the kit's dev packages. Only protocol messages go to stdout.
kit=$(cd "$(dirname "$0")/.." && pwd)
UV_PROJECT_ENVIRONMENT=${UV_PROJECT_ENVIRONMENT:-$(cd "$kit/../.." && pwd)/.work/venvs/bridge-kit}
export UV_PROJECT_ENVIRONMENT
exec "$kit/bin/bridge-kit-run" sh -c '
    command -v uv >/dev/null 2>&1 || { echo "bridge-kit-mcp: uv isn'\''t in the environment bridge-kit.yaml declares" >&2; exit 1; }
    exec uv run --quiet --no-dev --project "$0" python -m bridge_kit.mcp "$@"' "$kit" "$@"
